# ---- 管理后台 ----
# 管理密码。留空 = 免密（仅当 HOST 为 loopback 时允许启动）。
# 对外暴露时【必须】设置。
ADMIN_PASSWORD=

# 64 位 hex（32 字节）。用于加密 refresh token 与设备私钥。
# 不设则首次启动自动生成到 DATA_DIR/master.key（0600）。
# 丢失则已存凭据全部解不开，请妥善备份。生成：openssl rand -hex 32
MASTER_KEY=

# ---- 监听 ----
HOST=0.0.0.0
PORT=8787

# ---- 模型网关 ----
# 模型请求是否必须携带 sk- API Key。
GATEWAY_KEY_REQUIRED=true

# Claude 伪装模式：relaxed=指纹+原文(超 200 字节截断)；strict=仅身份行。
CLAUDE_CLOAK_MODE=relaxed

# 503 model_capacity_exhausted 同模型退避重试：次数 / 退避基数毫秒。
CAPACITY_RETRIES=2
CAPACITY_BACKOFF_MS=1200

# 每账号上游并发槽上限。
ACCOUNT_MAX_CONCURRENCY=5

# ---- 出站代理（可选）----
# 形如 http://127.0.0.1:7890 ；Docker 内需用 host.docker.internal。
UPSTREAM_PROXY=

# ---- 上游覆盖（一般不用改）----
RELAY_URL=https://relay.mirasim.ai
AUTH_URL=https://auth.mirasim.ai
MIRASIM_CLIENT_VERSION=0.0.322
# relay 密封公钥（base64 X25519），仅在协议变更时覆盖。
MIRASIM_SEAL_PUBKEY=HlyNMMeGXryasYLJuYQ/9ksCD4AYVVy1zXKAtJdpJn4=
